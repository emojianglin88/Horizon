{
  "ai": {
    "provider": "ali",
    "model": "deepseek-v4-flash-0731",
    "base_url": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
    "api_key_env": "DASHSCOPE_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 1,
    "languages": ["zh", "en"],
    "analysis_concurrency": 2,
    "enrichment_concurrency": 2
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {"threshold": 7.0, "topic_dedup": true},
      "tech-blog": {"threshold": 6.0, "topic_dedup": true},
      "finance-news": {"threshold": 7.0, "topic_dedup": true}
    }
  },
  "sources": {
    "github": [
      {"type": "user_events", "username": "karpathy", "enabled": true, "profile": "tech-news"},
      {"type": "repo_releases", "owner": "openai", "repo": "openai-python", "enabled": true, "profile": "tech-news"},
      {"type": "repo_releases", "owner": "vllm-project", "repo": "vllm", "enabled": true, "profile": "tech-news"}
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 100,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "github-trending",
        "profile": "tech-news"
      },
      {
        "name": "CNBC Finance",
        "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      }
    ],
    "reddit": {"enabled": false, "subreddits": [], "users": [], "fetch_comments": 0},
    "telegram": {"enabled": false, "channels": []},
    "ossinsight": {"enabled": false}
  },
  "collection": {"time_window_hours": 24},
  "digest": {
    "max_items": 15,
    "profile_order": ["tech-news", "tech-blog", "finance-news"],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {"enabled": false}
}
